---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/utils';

const posts = (await getCollection('blog')).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page
	title="Blog"
	description="Posts about development, open source, and life."
>
	<PageHeader
		title="notes"
		subtitle="thoughts, projects, and the occasional ramble"
	/>
	{
		posts.length === 0 ? (
			<p class="text-copy">No posts yet — check back soon!</p>
		) : (
			<ul class="border-rule divide-rule divide-y border-y">
				{posts.map((post) => (
					<li>
						<a
							class="group grid gap-y-3 py-6 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] sm:gap-x-10 sm:py-8"
							href={`/blog/${post.id}/`}
						>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="meta text-muted sm:pt-3"
							>
								{formatDate(post.data.pubDate)}
							</time>
							<div>
								<h2 class="font-instrument group-hover:text-pigment text-4xl leading-tight tracking-tight text-balance group-hover:underline sm:text-5xl">
									{post.data.title}
								</h2>
								<p class="text-copy mt-3 max-w-[60ch]">
									{post.data.description}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
	<a
		class="group text-pigment mt-8 inline-flex min-h-11 items-center gap-2"
		href="/rss.xml"
	>
		<span class="group-hover:underline">subscribe via RSS</span>
		<span aria-hidden="true">↗&#xfe0e;</span>
	</a>
</Page>
