---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import LinkRow from '@/components/LinkRow.astro';
import { projects } from '@/config';
---

<Page title="Projects" description="Things I've built and contributed to.">
	<PageHeader title="work" subtitle="things i've built and tinkered with" />
	<ul class="border-rule divide-rule divide-y border-y">
		{
			projects.map((project) => (
				<LinkRow
					title={project.name}
					href={project.href}
					description={project.description}
					meta={project.tags.join(' · ')}
				/>
			))
		}
	</ul>
</Page>
