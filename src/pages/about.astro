---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/config';
---

<Page title="About" description={site.description}>
	<PageHeader title="about" subtitle="a little about me" />
	<div class="text-copy max-w-[60ch] space-y-6 text-lg leading-relaxed">
		<p>
			I'm Matilde, a systems programmer based in Europe. I mostly write Rust and
			occasionally mess with Gleam.
		</p>
		<p>
			I'm a free software enthusiast. I like re-building things from the ground
			up, hopefully to make them better.
		</p>
	</div>
</Page>
