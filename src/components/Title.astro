---
interface Props {
	title: string;
	id?: string;
	class?: string | undefined;
}

const {
	title,
	id,
	class: className = 'text-[clamp(48px,8vw,104px)] leading-[1.05]',
} = Astro.props;
---

<h1
	id={id}
	class:list={[
		'font-instrument text-pigment font-normal tracking-[-0.057em] text-balance mix-blend-multiply filter-[url(#ink-letterpress)] forced-colors:mix-blend-normal forced-colors:filter-none',
		className,
	]}
>
	<!-- Negative tracking makes the dot's selection box overlap the last letter:
	positioning the title paints it on top, and the dot keeps its full advance. -->
	<span class="relative">{title}</span><span class="text-ink tracking-normal">.</span>
</h1>
