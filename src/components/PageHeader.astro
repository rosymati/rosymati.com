---
import Title from '@/components/Title.astro';

interface Props {
	title: string;
	subtitle?: string;
	backHref?: string;
	backLabel?: string;
	/** Title size override, for long titles like post names. */
	size?: string;
}

const {
	title,
	subtitle,
	backHref = '/',
	backLabel = 'back home',
	size,
} = Astro.props;
---

<a
	class="group text-pigment mb-6 inline-flex min-h-11 items-center gap-1.75 sm:mb-8"
	href={backHref}
>
	<span aria-hidden="true">←</span>
	<span class="group-hover:underline">{backLabel}</span>
</a>
<header class="mb-12 sm:mb-16">
	<slot />
	<Title title={title} class={size} />
	{subtitle && (
		<p class="font-instrument text-copy mt-3 text-2xl leading-[1.3] italic sm:mt-4 sm:text-[28px]">
			{subtitle}
		</p>
	)}
</header>
