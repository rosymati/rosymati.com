---
interface Props {
	title: string;
	href: string;
	description: string;
	meta?: string;
}

const { title, href, description, meta } = Astro.props;
const external = href.startsWith('https:');
---

<li>
	<a
		class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 py-6 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)_auto] sm:gap-x-10 sm:py-8"
		href={href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener noreferrer' : undefined}
	>
		<div>
			<h2
				class="font-instrument group-hover:text-pigment text-4xl leading-tight tracking-tight group-hover:underline sm:text-5xl"
			>
				{title}
			</h2>
			{meta && <p class="meta text-leaf mt-2">{meta}</p>}
		</div>
		<p
			class="text-copy col-span-2 col-start-1 row-start-2 max-w-[48ch] sm:col-span-1 sm:col-start-2 sm:row-start-1"
		>
			{description}
		</p>
		<span
			class="text-pigment col-start-2 row-start-1 text-2xl sm:col-start-3"
			aria-hidden="true">↗&#xfe0e;</span
		>
	</a>
</li>
