{
	"name": "rosymati.com",
	"type": "module",
	"version": "0.0.1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.1",
				"onFail": "download"
			}
		]
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --check .",
		"format:fix": "prettier --write --list-different .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"wrangler": "wrangler",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.19",
		"astro": "7.4.13",
		"giscus": "^1.6.0",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/sitemap": "3.7.6",
		"@prettier/plugin-oxc": "^0.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"oxlint": "^1.95.0",
		"prettier": "=3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.167.0"
	}
}
